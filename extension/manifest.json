{
  "manifest_version": 3,
  "name": "PM — Proceed Methodically",
  "short_name": "PM",
  "description": "Project command center to continue existing threads or start new ChatGPT Project conversations.",
  "version": "0.10.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "PM — Proceed Methodically",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "project-panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "0.10.0 — Full Side Panel Release Candidate",
  "side_panel": {
    "default_path": "panel.html"
  }
}
